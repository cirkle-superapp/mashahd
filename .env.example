# Mashahd — Environment Variables
# Copy this file to .env and fill in the values. Do NOT commit real secrets.

# ── App ──
APP_URL=http://localhost:3000
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ── Turso (libSQL) production database ──
# When TURSO_URL + TURSO_AUTH_TOKEN are set, the app uses Turso instead of
# local SQLite. Generate tokens from app.turso.io.
# TURSO_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token-here

# ── Media storage ──
# Local filesystem path for media assets (originals + HLS renditions).
MEDIA_STORAGE_PATH=/home/z/my-project/storage
# Optional: "local" (default, zero-cost) or "s3" (requires S3 env below).
STORAGE_PROVIDER=local

# ── FFmpeg ──
# Override if ffmpeg/ffprobe are not on PATH. Defaults: ffmpeg / ffprobe.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── P2P / WebRTC ──
# Master kill switch for P2P acceleration.
P2P_ENABLED=true
# Max concurrent peers per viewer (bounded participation).
P2P_MAX_PEERS=6
# Max upload bandwidth a viewer contributes (Mbps).
P2P_MAX_UPLOAD_MBPS=2
# Max total bytes a viewer uploads per session.
P2P_MAX_UPLOAD_BYTES=262144000
# WebSocket signaling URL (the self-hosted tracker mini-service).
P2P_SIGNALING_URL=ws://localhost:3003
# Background-tab P2P (default false — background tabs don't upload).
P2P_BACKGROUND_ENABLED=false
# Low-battery mode (receive-only when battery is low).
P2P_LOW_BATTERY_MODE=true
# TURN relay (default false — never required, falls back to HTTP).
TURN_ENABLED=false

# ── AI Providers (multi-provider with fallback — NO z-ai) ──
# The system tries providers in priority order: Groq → OpenRouter → NVIDIA → Gemini → HF
# All have free tiers, none require payment card.
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
NVIDIA_API_KEY=your-nvidia-api-key
GEMINI_API_KEY=your-gemini-api-key
HF_API_KEY=your-huggingface-api-key

# ── Neon Postgres (analytics/telemetry warehouse — optional) ──
# Used for aggregated analytics, QoE dashboards, AI usage tracking.
# Turso remains the primary control-plane DB.
# NEON_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── Brevo (transactional email — optional, free 300/day) ──
# Replaces Resend. No payment card required.
# BREVO_API_KEY=your-brevo-api-key
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME=Mashahd

# ── SMS (customer-funded — NOT free platform service) ──
# SMS requires explicit customer authorization + billing consent.
# No SMS provider is configured by default.
# SMS_PROVIDER=twilio  # Set when an SMS provider is configured
# SMS_PROVIDER_KEY=your-sms-provider-key

# ── Inngest (background jobs — optional) ──
# Used for media transcoding, GC, reconciliation, telemetry flush.
# Jobs are durable, retriable, and observable.
# INNGEST_KEY=your-inngest-signing-key

# ── CORS / Security ──
# Comma-separated list of allowed origins for media CORS.
ALLOWED_ORIGINS=http://localhost:3000

# ── Optional: Filebase storage (STORAGE_PROVIDER=filebase) ──
# Filebase is S3-compatible with IPFS pinning. Free tier: 5GB, no payment card.
# NOTE: Buckets must be created via the Filebase dashboard (console.filebase.com)
# — S3 API bucket creation is blocked on the free plan.
# FILEBASE_ACCESS_KEY_ID=your-filebase-access-key
# FILEBASE_SECRET_ACCESS_KEY=your-filebase-secret-key
# FILEBASE_BUCKET=mashahd-media
# FILEBASE_PUBLIC_BASE_URL=https://ipfs.filebase.io/ipfs

# ── Optional: S3-compatible storage (STORAGE_PROVIDER=s3) ──
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
