// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

model Channel {
  id           String   @id @default(cuid())
  name         String
  handle       String   @unique
  avatarUrl    String
  bannerColors String // comma-separated hex colors used to render the gradient banner
  // Optional custom banner image URL. Falls back to the bannerColors gradient.
  bannerUrl    String   @default("")
  description  String
  subscribers  Int      @default(0)
  // Verification badge (social-media structuring audit gap). False by default;
  // set true via admin tooling when a creator is verified.
  verified     Boolean  @default(false)
  // Creator economy: link the channel to its owning User. Nullable so existing
  // seeded/demo channels (created before this field existed) still resolve.
  ownerId      String?
  // Pipe-separated social/external links (e.g. "twitter@x|website=https:...").
  // SQLite can't store a list, so we use a serialized string (project rule).
  links        String   @default("")
  // ISO country code for the channel (for localization + recommendations).
  country      String   @default("")
  createdAt    DateTime @default(now())

  videos       Video[]
  owner        User?    @relation("ChannelOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
}

model Video {
  id           String   @id @default(cuid())
  title        String
  description  String
  thumbnailUrl String
  videoUrl     String
  durationSec  Int
  views        Int      @default(0)
  likes        Int      @default(0)
  dislikes     Int      @default(0)
  category     String
  tags         String   @default("") // pipe-separated
  channelId    String
  // Social-media structuring audit: visibility + scheduling + language.
  // public | unlisted | private | scheduled (default public for back-compat).
  visibility   String   @default("public")
  // When the video becomes public. For scheduled premieres this is the future
  // release time; for immediate uploads it equals createdAt.
  publishedAt  DateTime @default(now())
  // ISO 639-1 language code (e.g. "en", "ar"). Empty = unknown.
  language     String   @default("")
  // Age restriction flag (audit gap). True = 18+ only.
  ageGated     Boolean  @default(false)
  // §43: Creator controls clipping behavior. Default: allowed.
  // Values: "allowed" (default) | "disabled" (no clips) | "followers_only"
  clipPolicy   String   @default("allowed")
  createdAt    DateTime @default(now())

  channel      Channel  @relation(fields: [channelId], references: [id])
  comments     Comment[]
  sources      VideoSource[]
  renditions   VideoRendition[]
  manifests    VideoManifest[]
  jobs         MediaProcessingJob[]

  @@index([category])
  @@index([channelId])
  @@index([createdAt])
  @@index([visibility])
}

model Comment {
  id           String   @id @default(cuid())
  videoId      String
  author       String
  avatarUrl    String
  text         String
  likes        Int      @default(0)
  // Timestamp the comment is pinned to (in seconds from video start).
  // null = a regular comment; a number = a timestamp comment (clickable).
  timestamp    Int?
  // Threading: a reply has a parentId pointing to the top-level comment.
  // null = top-level comment; a string = a reply to that comment.
  parentId     String?
  createdAt    DateTime @default(now())

  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([parentId])
  @@index([videoId, timestamp])
}

// Tracks client-side state persisted across the API (likes, subscriptions,
// watch history). We use an anonymous browserId (generated on the client)
// rather than full auth to keep the demo simple.
model UserState {
  id        String   @id @default(cuid())
  browserId String   @unique
  likedVideoIds      String @default("") // pipe-separated video ids
  dislikedVideoIds   String @default("") // pipe-separated video ids (audit: wire dislike)
  subscribedChannelIds String @default("") // pipe-separated channel ids
  watchedVideoIds    String @default("") // pipe-separated video ids, most recent first
  favoriteVideoIds   String @default("") // pipe-separated video ids (Favorites / Save)
  watchLaterIds      String @default("") // pipe-separated video ids (Watch Later queue)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlists          Playlist[]
}

/// User-created playlists. A playlist belongs to a UserState (anonymous
/// browser or authenticated user) and can be public (shareable link) or
/// private. Videos are added via PlaylistItem (ordered, with an addedAt
/// timestamp so we can show "added 2 days ago" and preserve insertion order).
model Playlist {
  id          String   @id @default(cuid())
  userStateId String
  title       String
  description String   @default("")
  visibility  String   @default("public") // public | private | unlisted
  // Optional cover image — falls back to the first video's thumbnail.
  coverUrl    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userState   UserState     @relation(fields: [userStateId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]

  @@index([userStateId])
}

/// A video inside a playlist. The `position` field preserves order even
/// after removals (we compact on removal). Unique on [playlistId, videoId]
/// so the same video can't be added twice to the same playlist.
model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId, position])
}

/// A user-created clip — a short segment (start → end seconds) of a video
/// that can be shared with a permalink. Clips drive viral growth: viewers
/// can highlight the best 15-60 seconds of a long video and share them.
model Clip {
  id          String   @id @default(cuid())
  videoId     String
  // The creator of the clip (anonymous browserId or userId).
  creatorId   String
  creatorName String   @default("Anonymous")
  title       String
  startSec    Int      // clip start (seconds)
  endSec      Int      // clip end (seconds)
  // Optional: a note the clipper adds.
  note        String   @default("")
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([videoId])
  @@index([creatorId])
}

// ── CIRKLE Authentication ──
// Users can register/sign in with email, phone number, or username.
// On registration they choose a unique CIRKLE username (live availability
// check). The system also auto-suggests an available handle if the chosen
// one is taken.

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  username      String   @unique // the CIRKLE username, chosen on signup
  displayName   String
  avatarUrl     String   @default("")
  bio           String   @default("")
  passwordHash  String   @default("") // bcrypt hash; empty for passkey-only
  verified      Boolean  @default(false) // email/phone verified
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  ownedChannels Channel[] @relation("ChannelOwner")
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  token         String   @unique // random session token
  browserId     String?  // links to the anonymous UserState if upgraded
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ── Streaming-platform models (hybrid CDN + WebRTC P2P) ──
// These extend the existing Video model with ingestion-pipeline state,
// renditions, manifests, swarms, and playback telemetry. The existing
// Video / Channel / Comment models are preserved unchanged.

model VideoSource {
  id              String   @id @default(cuid())
  videoId         String
  sourceHash      String   // sha256 of the uploaded file
  originalName    String
  storagePath     String   // relative path under MEDIA_STORAGE_PATH
  fileSize        Int      // bytes
  duration        Float    // seconds
  width           Int
  height          Int
  codec           String
  audioCodec      String
  frameRate       Float
  bitrate         Int      // kbps
  createdAt       DateTime @default(now())

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model VideoRendition {
  id            String   @id @default(cuid())
  videoId       String
  resolution    String   // "1080p", "720p", "480p", "360p"
  height        Int
  width         Int
  bitrate       Int      // kbps
  codec         String   // e.g. "h264"
  manifestPath  String   // relative path to index.m3u8
  createdAt     DateTime @default(now())

  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model VideoManifest {
  id              String   @id @default(cuid())
  videoId         String
  version         String   // "v1", "v2", ...
  hash            String   // sha256 of the manifest contents
  manifestPath    String   // relative path to master.m3u8
  createdAt       DateTime @default(now())

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model MediaProcessingJob {
  id              String   @id @default(cuid())
  videoId         String
  status          String   // UPLOADING | UPLOADED | QUEUED | CLAIMED | PROCESSING | PACKAGING | VALIDATING | READY | FAILED | RETRYABLE_FAILURE | PERMANENT_FAILURE | CANCELLED
  progress        Int      @default(0) // 0-100
  error           String   @default("")
  errorClass      String   @default("") // transient | permanent | ""
  profile         String   @default("cpu-safe") // cpu-safe | balanced | high-quality
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  priority        Int      @default(0) // higher = more urgent
  claimedBy       String?  // worker identity (hostname + pid)
  claimedAt       DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([status])
  @@index([status, priority])
}

model Swarm {
  id              String   @id @default(cuid())
  swarmId         String   @unique // sha256(videoId + renditionId + manifestVersion)
  videoId         String
  renditionId     String
  manifestVersion String
  activePeers     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([videoId])
  @@index([swarmId])
}

model PlaybackSession {
  id              String   @id @default(cuid())
  videoId         String
  renditionId     String
  peerId          String   // temporary, rotated per session
  browserId       String
  networkType     String   @default("unknown")
  swarmId         String?
  p2pEnabled      Boolean  @default(false)
  startedAt       DateTime @default(now())
  endedAt         DateTime?

  @@index([videoId])
  @@index([peerId])
}

model PlaybackTelemetry {
  id              String   @id @default(cuid())
  sessionId       String
  videoId         String
  cdnBytes        Int      @default(0)
  p2pBytes        Int      @default(0)
  rebufferCount   Int      @default(0)
  rebufferDuration Float   @default(0) // seconds
  startupTime     Float    @default(0) // seconds
  peerCount       Int      @default(0)
  p2pFailures     Int      @default(0)
  httpFallbackCount Int    @default(0)
  currentRendition String  @default("")
  timestamp       DateTime @default(now())

  @@index([sessionId])
  @@index([videoId])
}

// ── Transactional Outbox (§20) ──
// Every critical business mutation requiring downstream effects writes
// BUSINESS DATA + OUTBOX EVENT in the same Turso transaction.
// Inngest processes the outbox asynchronously.
model OutboxEvent {
  id              String   @id @default(cuid())
  aggregateType   String   // e.g. "User", "Video", "Comment"
  aggregateId     String   // e.g. the user/video/comment ID
  eventType       String   // e.g. "user.registered", "video.uploaded"
  schemaVersion   Int      @default(1)
  payload         String   // JSON-encoded event payload
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())
  processedAt     DateTime?
  attemptCount    Int      @default(0)
  status          String   @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED | DEAD_LETTER
  lastError       String   @default("")
  idempotencyKey  String?  @unique
  correlationId   String?
  causationId     String?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

// ── Notifications (social-media structuring audit gap) ──
// In-app notifications for the bell icon. Replaces the SAMPLE_NOTIFS hardcoded
// mock. Notifications are created by domain events (new comment on your video,
// new subscriber, new video from a subscribed channel, tip received) and read
// via /api/notifications (cursor-paginated).
model Notification {
  id          String    @id @default(cuid())
  // Recipient: a userId (authenticated) or browserId (anonymous).
  recipientId String
  // Type of notification for icon + routing.
  type        String    // new_video | new_comment | new_subscriber | tip_received | system | mention
  // JSON-encoded payload (title, body, linkUrl, actorAvatarUrl, etc.).
  payload     String
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, read])
}

// ── Notification preferences (per-user bell settings) ──
// Persisted notification preference per user. Replaces the stateless React
// toggles flagged by the audit.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  newVideos    Boolean  @default(true)
  comments     Boolean  @default(true)
  subscribers  Boolean  @default(true)
  tips         Boolean  @default(true)
  mentions     Boolean  @default(true)
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Shares (engagement tracking — audit gap) ──
// Records when a user shares a video (for virality metrics + recommendations).
model Share {
  id          String   @id @default(cuid())
  videoId     String
  // The sharer (userId or anonymous browserId).
  sharerId    String
  // Where the share went (twitter | facebook | copy_link | email | ...).
  platform    String   @default("copy_link")
  createdAt   DateTime @default(now())

  @@index([videoId])
  @@index([sharerId])
}

// ── User Preferences (§69 — user defaults) ──
// Persists user-controlled preferences so the user doesn't reconfigure the
// experience every visit. Quality, speed, Shorts, AI-content, home mode,
// discovery mix, search sort, etc.
model UserPreference {
  id              String   @id @default(cuid())
  // The signed browserId (anonymous) or userId (authenticated).
  ownerId         String   @unique
  // ── Player defaults (§33-36) ──
  preferredQuality String  @default("auto") // auto | 144p | 240p | 360p | 480p | 720p | 1080p | 1440p | 2160p
  preferredSpeed   Float    @default(1) // 0.5 | 0.75 | 1 | 1.25 | 1.5 | 2
  preferredVolume  Int      @default(100) // 0-100
  // ── Subtitle + audio preferences (§35-36) ──
  preferredSubtitleLang String @default("") // ISO 639-1, empty = off
  preferredAudioLang String  @default("") // empty = original
  // ── Content preferences (§16-18) ──
  disableShorts    Boolean  @default(false) // §16: persistent "disable Shorts"
  aiContentFilter  String   @default("show_all") // show_all | prefer_human | reduce_ai | hide_ai
  // ── Home feed preferences (§6) ──
  homeMode         String   @default("smart") // focus | following | chronological | discovery | smart | random
  // Discovery mix percentages (§9) — must sum to ~100.
  discoveryFamiliar Int     @default(60) // % familiar content
  discoveryNewCreators Int  @default(25) // % new creators
  discoveryUnexpected Int   @default(15) // % unexpected subjects
  // ── Search defaults (§12) ──
  searchSort       String   @default("relevance") // relevance | newest | oldest | most_viewed | least_viewed | longest | shortest
  // ── Privacy (§26, §55) ──
  pauseRecommendationLearning Boolean @default(false) // §26: pause rec learning
  // §55: Data privacy — control visibility of user activity.
  // Each can be: public | followers | private (default: private for a
  // user-controlled platform).
  likesVisibility      String   @default("private") // §55
  subscriptionsVisibility String @default("private") // §55
  historyVisibility    String   @default("private") // §55
  playlistsVisibility  String   @default("public") // §55 — playlists are shareable by default
  commentsVisibility   String   @default("public") // §55 — comments are public by default
  // ── Accessibility (§58) ──
  reducedMotion    Boolean  @default(false)
  highContrast     Boolean  @default(false)
  largeControls    Boolean  @default(false)
  // ── Continue Watching (§32) ──
  continueWatchingEnabled Boolean @default(true)
  autoplayNext     Boolean  @default(false)
  // §68: Simple mode = clean defaults; Advanced mode = full controls.
  // Advanced users must not lose capabilities (spec §68).
  uiMode           String   @default("simple") // simple | advanced
  // Timestamps.
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── Recommendation Feedback (§10 — negative controls) ──
// Records explicit user feedback on recommendations. Each feedback has a
// real, persistent effect on the recommendation engine.
model RecommendationFeedback {
  id          String   @id @default(cuid())
  userId      String   // signed browserId or userId
  videoId     String
  // The reason the user gave (§10).
  reason      String   // not_interested | already_watched | wrong_topic | too_repetitive | low_quality | clickbait | misleading | wrong_language | wrong_format | ai_generated | dont_like_creator
  // Optional free-text note from the user.
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@unique([userId, videoId]) // one feedback per user+video
  @@index([userId])
  @@index([videoId])
}

// ── User Blocks (§11 — topic/keyword/creator blocking) ──
// Persistent blocks that affect Home, Search, Up Next, Discovery, and
// Notifications (§11). The FYP and search must filter these out.
model UserBlock {
  id          String   @id @default(cuid())
  userId      String   // signed browserId or userId
  // The type of block (§11).
  blockType   String   // topic | keyword | creator | content_type | language | ai_content
  // The value being blocked (e.g. "technology" for topic, "@spammer" for creator).
  blockValue  String
  createdAt   DateTime @default(now())

  @@unique([userId, blockType, blockValue])
  @@index([userId])
  @@index([blockType])
}

// ── Continue Watching (§32 — cross-device playback state) ──
// Persists where the user left off so they can resume on any device.
model ContinueWatching {
  id          String   @id @default(cuid())
  userId      String   // signed browserId or userId
  videoId     String
  // Where the user stopped (seconds into the video).
  position    Float    @default(0)
  // Whether the video was completed.
  completed   Boolean  @default(false)
  // Playback state to restore (§32).
  playbackSpeed Float  @default(1)
  qualityPref String   @default("auto")
  audioLang   String   @default("")
  subtitleLang String  @default("")
  updatedAt   DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
  @@index([updatedAt])
}

// ── Content Provenance (§17 — AI-content labeling) ──
// Records the origin of a video so users can make informed choices (§18).
model ContentProvenance {
  id          String   @id @default(cuid())
  videoId     String   @unique
  // The overall origin (§17).
  origin      String   @default("unknown") // human | ai_assisted | ai_generated | mixed | unknown
  // Component-level origin (§17) — JSON-encoded: { voice, visuals, script, music, translation, dubbing }
  components  String   @default("{}")
  // Creator-declared source/provenance metadata.
  sourceNote  String   @default("")
  // Whether the provenance was creator-declared or platform-detected.
  declared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([origin])
}

// ── Interest Profiles (§28 — multiple recommendation contexts) ──
// Users can have separate recommendation contexts (Personal, Work, Research,
// Entertainment, etc.) WITHOUT separate accounts. Each profile has its own
// affinity + feedback + blocks, but shares subscriptions + playlists.
model InterestProfile {
  id          String   @id @default(cuid())
  userId      String   // signed browserId or userId
  name        String   // e.g. "Personal", "Work", "Research"
  // Pipe-separated categories this profile is interested in (§28).
  categories  String   @default("")
  // Whether this is the active profile (only one active per user at a time).
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ── Smart Playlists (§30 — rule-based dynamic playlists) ──
// Playlists that update dynamically based on rules. E.g. "All unwatched
// videos under 20 minutes from followed creators" or "All videos about
// technology saved during the last 30 days."
model SmartPlaylist {
  id          String   @id @default(cuid())
  userId      String   // signed browserId or userId
  name        String
  description String   @default("")
  // JSON-encoded rules: { categories: [], creators: [], maxDuration: N,
  //   minDuration: N, unwatchedOnly: bool, savedOnly: bool, dateRange: "7d|30d|all" }
  rules       String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ── Recommendation Changelog (§70 — "My Recommendation Profile") ──
// Records meaningful events that shaped the user's recommendation profile.
// Shows the user WHY their feed looks the way it does (transparency).
model RecommendationChangelog {
  id          String   @id @default(cuid())
  userId      String   // signed browserId or userId
  // The type of event (§70).
  eventType   String   // followed_creator | blocked_topic | watched_repeated_topic | negative_feedback | positive_feedback | reset_profile | preference_changed
  // Human-readable description of what happened.
  description String
  // Optional metadata (JSON-encoded: videoId, category, reason, etc.)
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Comment enhancements (§22 — sort + question/answer tracking) ──
// Extends the existing Comment model with fields for:
//   - isQuestion: marks a comment as a question (for §22 "questions" sort)
//   - isCreatorReply: marks a reply as from the video's creator (for §22 "creator replies" sort)
//   - pinnedBy: if set, the comment is pinned to the top by the creator
// NOTE: We add these as a separate model to avoid destructive migrations
// on the existing Comment table. The comments API joins them.
model CommentMeta {
  id            String   @id @default(cuid())
  commentId     String   @unique
  isQuestion    Boolean  @default(false)
  isCreatorReply Boolean @default(false)
  pinnedBy      String?  // creator userId who pinned, null = not pinned
  pinnedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([commentId])
  @@index([isQuestion])
  @@index([isCreatorReply])
}

// ── Video Relationship Graph (§41) ──
// Associates videos with: earlier videos, later updates, responses,
// corrections, source materials, related tutorials, same topic, same creator.
model VideoRelationship {
  id            String   @id @default(cuid())
  videoId       String   // the source video
  relatedVideoId String  // the related video
  // The type of relationship (§41).
  relationType  String   // earlier | later | response | correction | source | tutorial | same_topic | same_creator | other
  // Optional note explaining the relationship.
  note          String   @default("")
  // Who created this relationship: creator | system | community
  createdBy     String   @default("system")
  createdAt     DateTime @default(now())

  @@unique([videoId, relatedVideoId, relationType])
  @@index([videoId])
  @@index([relatedVideoId])
  @@index([relationType])
}

// ── Creator Corrections (§66) ──
// Creators can mark and publish corrections to their videos.
// Where appropriate, notify viewers who watched the affected content.
model VideoCorrection {
  id            String   @id @default(cuid())
  videoId       String
  // The timestamp in the video where the correction applies (seconds).
  timestamp     Int      @default(0)
  // What was wrong.
  originalText  String
  // What it should be.
  correctedText String
  // Optional note from the creator.
  note          String   @default("")
  // Whether viewers who watched this video have been notified.
  viewersNotified Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([videoId])
}

// ── Playlist Folders (§29 — folders, collections, sorting, bulk editing) ──
// Users can organize playlists into folders for better library management.
model PlaylistFolder {
  id          String   @id @default(cuid())
  userStateId String
  name        String
  // Optional parent folder for nesting (1 level deep max, enforced in app logic).
  parentId    String?
  position    Int      @default(0) // sort order within the parent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userStateId])
  @@index([parentId])
}

// ── Active Sessions (§57 — account security, device management) ──
// Tracks all active sessions for a user (devices, IPs, last seen).
model ActiveSession {
  id          String   @id @default(cuid())
  userId      String   // signed browserId or authenticated userId
  // A fingerprint of the device/browser (user agent + screen size hash).
  deviceFingerprint String
  // Human-readable device name (e.g. "Chrome on macOS").
  deviceName  String   @default("Unknown device")
  // The IP address of the session (for security display).
  ipAddress   String   @default("")
  // The user agent string.
  userAgent   String   @default("")
  // When the session was last active.
  lastSeenAt  DateTime @default(now())
  // Whether this is the current session.
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([deviceFingerprint])
}

// ── Content Rights System (§53-54 — ownership, licenses, claims, disputes) ──
// Per spec §53: "Support where relevant: ownership metadata, licenses,
// territorial restrictions, audio rights, music rights, claims, disputes,
// evidence, counter-notices, enforcement records."
// Per spec §54: "A rights claim should expose: matched material, approximate
// location/timestamp, claimant, claim type, action, dispute pathway."
model RightsClaim {
  id              String   @id @default(cuid())
  videoId         String
  // Who filed the claim (claimant name or ID).
  claimant        String
  // The type of claim (§53).
  claimType       String   // copyright | trademark | music | audio | visual | other
  // The material that was matched (e.g. "Song: 'Example' by Artist").
  matchedMaterial String
  // Approximate location in the video where the match occurs (seconds).
  timestampStart  Int      @default(0)
  timestampEnd    Int      @default(0)
  // The action taken (§54).
  action          String   @default("monetize") // monetize | block | mute | track | none
  // Territorial restrictions (pipe-separated ISO country codes, empty = worldwide).
  territory       String   @default("")
  // The dispute status (§24, §53).
  status          String   @default("active") // active | disputed | resolved | withdrawn | counter_noticed
  // Evidence/note from the claimant.
  evidence        String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([videoId])
  @@index([status])
}

// ── Rights Disputes (§24, §53-54 — appeal workflow) ──
// Per spec §24: "Implement an appeal workflow for meaningful moderation and
// rights decisions. Track: submitted, under review, additional information
// requested, accepted, rejected, closed."
model RightsDispute {
  id              String   @id @default(cuid())
  claimId         String
  // Who filed the dispute (creator userId or name).
  disputant       String
  // The reason for the dispute.
  reason          String
  // Evidence/note from the disputant.
  evidence        String   @default("")
  // The dispute status (§24).
  status          String   @default("submitted") // submitted | under_review | info_requested | accepted | rejected | closed
  // Resolution note (filled when accepted/rejected/closed).
  resolution      String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([claimId])
  @@index([status])
}

// ── Live Streaming Enhancements (§45 — chat modes, polls, Q&A, DVR) ──
// Per spec §45: "Support where applicable: low latency, chat, moderation,
// slow mode, subscriber/follower mode, polls, Q&A, replay, DVR, clips, chapters."
model LivePoll {
  id          String   @id @default(cuid())
  // The videoId of the live stream (live streams are stored as Video records with visibility="live").
  videoId     String
  question    String
  // JSON-encoded options: [{ "text": "Yes", "votes": 0 }, { "text": "No", "votes": 0 }]
  options     String   @default("[]")
  // Poll status: active | closed
  status      String   @default("active")
  createdAt   DateTime @default(now())
  closedAt    DateTime?

  @@index([videoId])
  @@index([status])
}

model LiveQA {
  id          String   @id @default(cuid())
  videoId     String
  // The viewer who asked the question.
  askerName   String
  askerAvatar String   @default("")
  question    String
  // Optional answer from the creator.
  answer      String   @default("")
  answeredBy  String   @default("")
  answeredAt  DateTime?
  // upvotes from other viewers.
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([videoId])
  @@index([answeredBy])
}

// ── Advertising Transparency (§61 — separate platform/creator/affiliate) ──
// Per spec §61: "Separate: platform advertising, creator sponsorship,
// affiliate content, paid placement. Never make paid content deceptive."
// Per spec §15: "Never make paid placements look identical to organic results."
model AdDisclosure {
  id          String   @id @default(cuid())
  videoId     String
  // The type of advertising (§61).
  adType      String   // platform_ad | creator_sponsorship | affiliate | paid_placement
  // The sponsor/brand name.
  sponsor     String
  // The product/service being promoted.
  product     String   @default("")
  // Whether this is a paid placement that must be disclosed.
  isPaid      Boolean  @default(true)
  // Optional disclosure note from the creator.
  disclosureNote String @default("")
  createdAt   DateTime @default(now())

  @@index([videoId])
  @@index([adType])
}
