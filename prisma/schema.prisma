// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

model Channel {
  id           String   @id @default(cuid())
  name         String
  handle       String   @unique
  avatarUrl    String
  bannerColors String // comma-separated hex colors used to render the gradient banner
  description  String
  subscribers  Int      @default(0)
  createdAt     DateTime @default(now())

  videos       Video[]
}

model Video {
  id           String   @id @default(cuid())
  title        String
  description  String
  thumbnailUrl String
  videoUrl     String
  durationSec  Int
  views        Int      @default(0)
  likes        Int      @default(0)
  dislikes     Int      @default(0)
  category     String
  tags         String   @default("") // pipe-separated
  channelId    String
  createdAt    DateTime @default(now())

  channel      Channel  @relation(fields: [channelId], references: [id])
  comments     Comment[]
  sources      VideoSource[]
  renditions   VideoRendition[]
  manifests    VideoManifest[]
  jobs         MediaProcessingJob[]

  @@index([category])
  @@index([channelId])
  @@index([createdAt])
}

model Comment {
  id           String   @id @default(cuid())
  videoId      String
  author       String
  avatarUrl    String
  text         String
  likes        Int      @default(0)
  // Timestamp the comment is pinned to (in seconds from video start).
  // null = a regular comment; a number = a timestamp comment (clickable).
  timestamp    Int?
  // Threading: a reply has a parentId pointing to the top-level comment.
  // null = top-level comment; a string = a reply to that comment.
  parentId     String?
  createdAt    DateTime @default(now())

  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([parentId])
  @@index([videoId, timestamp])
}

// Tracks client-side state persisted across the API (likes, subscriptions,
// watch history). We use an anonymous browserId (generated on the client)
// rather than full auth to keep the demo simple.
model UserState {
  id        String   @id @default(cuid())
  browserId String   @unique
  likedVideoIds      String @default("") // pipe-separated video ids
  subscribedChannelIds String @default("") // pipe-separated channel ids
  watchedVideoIds    String @default("") // pipe-separated video ids, most recent first
  favoriteVideoIds   String @default("") // pipe-separated video ids (Favorites / Save)
  watchLaterIds      String @default("") // pipe-separated video ids (Watch Later queue)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlists          Playlist[]
}

/// User-created playlists. A playlist belongs to a UserState (anonymous
/// browser or authenticated user) and can be public (shareable link) or
/// private. Videos are added via PlaylistItem (ordered, with an addedAt
/// timestamp so we can show "added 2 days ago" and preserve insertion order).
model Playlist {
  id          String   @id @default(cuid())
  userStateId String
  title       String
  description String   @default("")
  visibility  String   @default("public") // public | private | unlisted
  // Optional cover image — falls back to the first video's thumbnail.
  coverUrl    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userState   UserState     @relation(fields: [userStateId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]

  @@index([userStateId])
}

/// A video inside a playlist. The `position` field preserves order even
/// after removals (we compact on removal). Unique on [playlistId, videoId]
/// so the same video can't be added twice to the same playlist.
model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId, position])
}

/// A user-created clip — a short segment (start → end seconds) of a video
/// that can be shared with a permalink. Clips drive viral growth: viewers
/// can highlight the best 15-60 seconds of a long video and share them.
model Clip {
  id          String   @id @default(cuid())
  videoId     String
  // The creator of the clip (anonymous browserId or userId).
  creatorId   String
  creatorName String   @default("Anonymous")
  title       String
  startSec    Int      // clip start (seconds)
  endSec      Int      // clip end (seconds)
  // Optional: a note the clipper adds.
  note        String   @default("")
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([videoId])
  @@index([creatorId])
}

// ── CIRKLE Authentication ──
// Users can register/sign in with email, phone number, or username.
// On registration they choose a unique CIRKLE username (live availability
// check). The system also auto-suggests an available handle if the chosen
// one is taken.

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  username      String   @unique // the CIRKLE username, chosen on signup
  displayName   String
  avatarUrl     String   @default("")
  bio           String   @default("")
  passwordHash  String   @default("") // bcrypt hash; empty for passkey-only
  verified      Boolean  @default(false) // email/phone verified
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  token         String   @unique // random session token
  browserId     String?  // links to the anonymous UserState if upgraded
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ── Streaming-platform models (hybrid CDN + WebRTC P2P) ──
// These extend the existing Video model with ingestion-pipeline state,
// renditions, manifests, swarms, and playback telemetry. The existing
// Video / Channel / Comment models are preserved unchanged.

model VideoSource {
  id              String   @id @default(cuid())
  videoId         String
  sourceHash      String   // sha256 of the uploaded file
  originalName    String
  storagePath     String   // relative path under MEDIA_STORAGE_PATH
  fileSize        Int      // bytes
  duration        Float    // seconds
  width           Int
  height          Int
  codec           String
  audioCodec      String
  frameRate       Float
  bitrate         Int      // kbps
  createdAt       DateTime @default(now())

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model VideoRendition {
  id            String   @id @default(cuid())
  videoId       String
  resolution    String   // "1080p", "720p", "480p", "360p"
  height        Int
  width         Int
  bitrate       Int      // kbps
  codec         String   // e.g. "h264"
  manifestPath  String   // relative path to index.m3u8
  createdAt     DateTime @default(now())

  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model VideoManifest {
  id              String   @id @default(cuid())
  videoId         String
  version         String   // "v1", "v2", ...
  hash            String   // sha256 of the manifest contents
  manifestPath    String   // relative path to master.m3u8
  createdAt       DateTime @default(now())

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model MediaProcessingJob {
  id              String   @id @default(cuid())
  videoId         String
  status          String   // UPLOADING | UPLOADED | QUEUED | CLAIMED | PROCESSING | PACKAGING | VALIDATING | READY | FAILED | RETRYABLE_FAILURE | PERMANENT_FAILURE | CANCELLED
  progress        Int      @default(0) // 0-100
  error           String   @default("")
  errorClass      String   @default("") // transient | permanent | ""
  profile         String   @default("cpu-safe") // cpu-safe | balanced | high-quality
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  priority        Int      @default(0) // higher = more urgent
  claimedBy       String?  // worker identity (hostname + pid)
  claimedAt       DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([status])
  @@index([status, priority])
}

model Swarm {
  id              String   @id @default(cuid())
  swarmId         String   @unique // sha256(videoId + renditionId + manifestVersion)
  videoId         String
  renditionId     String
  manifestVersion String
  activePeers     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([videoId])
  @@index([swarmId])
}

model PlaybackSession {
  id              String   @id @default(cuid())
  videoId         String
  renditionId     String
  peerId          String   // temporary, rotated per session
  browserId       String
  networkType     String   @default("unknown")
  swarmId         String?
  p2pEnabled      Boolean  @default(false)
  startedAt       DateTime @default(now())
  endedAt         DateTime?

  @@index([videoId])
  @@index([peerId])
}

model PlaybackTelemetry {
  id              String   @id @default(cuid())
  sessionId       String
  videoId         String
  cdnBytes        Int      @default(0)
  p2pBytes        Int      @default(0)
  rebufferCount   Int      @default(0)
  rebufferDuration Float   @default(0) // seconds
  startupTime     Float    @default(0) // seconds
  peerCount       Int      @default(0)
  p2pFailures     Int      @default(0)
  httpFallbackCount Int    @default(0)
  currentRendition String  @default("")
  timestamp       DateTime @default(now())

  @@index([sessionId])
  @@index([videoId])
}
