// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

model Channel {
  id           String   @id @default(cuid())
  name         String
  handle       String   @unique
  avatarUrl    String
  bannerColors String // comma-separated hex colors used to render the gradient banner
  // Optional custom banner image URL. Falls back to the bannerColors gradient.
  bannerUrl    String   @default("")
  description  String
  subscribers  Int      @default(0)
  // Verification badge (social-media structuring audit gap). False by default;
  // set true via admin tooling when a creator is verified.
  verified     Boolean  @default(false)
  // Creator economy: link the channel to its owning User. Nullable so existing
  // seeded/demo channels (created before this field existed) still resolve.
  ownerId      String?
  // Pipe-separated social/external links (e.g. "twitter@x|website=https:...").
  // SQLite can't store a list, so we use a serialized string (project rule).
  links        String   @default("")
  // ISO country code for the channel (for localization + recommendations).
  country      String   @default("")
  createdAt    DateTime @default(now())

  videos       Video[]
  owner        User?    @relation("ChannelOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
}

model Video {
  id           String   @id @default(cuid())
  title        String
  description  String
  thumbnailUrl String
  videoUrl     String
  durationSec  Int
  views        Int      @default(0)
  likes        Int      @default(0)
  dislikes     Int      @default(0)
  category     String
  tags         String   @default("") // pipe-separated
  channelId    String
  // Social-media structuring audit: visibility + scheduling + language.
  // public | unlisted | private | scheduled (default public for back-compat).
  visibility   String   @default("public")
  // When the video becomes public. For scheduled premieres this is the future
  // release time; for immediate uploads it equals createdAt.
  publishedAt  DateTime @default(now())
  // ISO 639-1 language code (e.g. "en", "ar"). Empty = unknown.
  language     String   @default("")
  // Age restriction flag (audit gap). True = 18+ only.
  ageGated     Boolean  @default(false)
  createdAt    DateTime @default(now())

  channel      Channel  @relation(fields: [channelId], references: [id])
  comments     Comment[]
  sources      VideoSource[]
  renditions   VideoRendition[]
  manifests    VideoManifest[]
  jobs         MediaProcessingJob[]

  @@index([category])
  @@index([channelId])
  @@index([createdAt])
  @@index([visibility])
}

model Comment {
  id           String   @id @default(cuid())
  videoId      String
  author       String
  avatarUrl    String
  text         String
  likes        Int      @default(0)
  // Timestamp the comment is pinned to (in seconds from video start).
  // null = a regular comment; a number = a timestamp comment (clickable).
  timestamp    Int?
  // Threading: a reply has a parentId pointing to the top-level comment.
  // null = top-level comment; a string = a reply to that comment.
  parentId     String?
  createdAt    DateTime @default(now())

  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([parentId])
  @@index([videoId, timestamp])
}

// Tracks client-side state persisted across the API (likes, subscriptions,
// watch history). We use an anonymous browserId (generated on the client)
// rather than full auth to keep the demo simple.
model UserState {
  id        String   @id @default(cuid())
  browserId String   @unique
  likedVideoIds      String @default("") // pipe-separated video ids
  dislikedVideoIds   String @default("") // pipe-separated video ids (audit: wire dislike)
  subscribedChannelIds String @default("") // pipe-separated channel ids
  watchedVideoIds    String @default("") // pipe-separated video ids, most recent first
  favoriteVideoIds   String @default("") // pipe-separated video ids (Favorites / Save)
  watchLaterIds      String @default("") // pipe-separated video ids (Watch Later queue)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlists          Playlist[]
}

/// User-created playlists. A playlist belongs to a UserState (anonymous
/// browser or authenticated user) and can be public (shareable link) or
/// private. Videos are added via PlaylistItem (ordered, with an addedAt
/// timestamp so we can show "added 2 days ago" and preserve insertion order).
model Playlist {
  id          String   @id @default(cuid())
  userStateId String
  title       String
  description String   @default("")
  visibility  String   @default("public") // public | private | unlisted
  // Optional cover image — falls back to the first video's thumbnail.
  coverUrl    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userState   UserState     @relation(fields: [userStateId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]

  @@index([userStateId])
}

/// A video inside a playlist. The `position` field preserves order even
/// after removals (we compact on removal). Unique on [playlistId, videoId]
/// so the same video can't be added twice to the same playlist.
model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId, position])
}

/// A user-created clip — a short segment (start → end seconds) of a video
/// that can be shared with a permalink. Clips drive viral growth: viewers
/// can highlight the best 15-60 seconds of a long video and share them.
model Clip {
  id          String   @id @default(cuid())
  videoId     String
  // The creator of the clip (anonymous browserId or userId).
  creatorId   String
  creatorName String   @default("Anonymous")
  title       String
  startSec    Int      // clip start (seconds)
  endSec      Int      // clip end (seconds)
  // Optional: a note the clipper adds.
  note        String   @default("")
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([videoId])
  @@index([creatorId])
}

// ── CIRKLE Authentication ──
// Users can register/sign in with email, phone number, or username.
// On registration they choose a unique CIRKLE username (live availability
// check). The system also auto-suggests an available handle if the chosen
// one is taken.

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  username      String   @unique // the CIRKLE username, chosen on signup
  displayName   String
  avatarUrl     String   @default("")
  bio           String   @default("")
  passwordHash  String   @default("") // bcrypt hash; empty for passkey-only
  verified      Boolean  @default(false) // email/phone verified
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  ownedChannels Channel[] @relation("ChannelOwner")
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  token         String   @unique // random session token
  browserId     String?  // links to the anonymous UserState if upgraded
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ── Streaming-platform models (hybrid CDN + WebRTC P2P) ──
// These extend the existing Video model with ingestion-pipeline state,
// renditions, manifests, swarms, and playback telemetry. The existing
// Video / Channel / Comment models are preserved unchanged.

model VideoSource {
  id              String   @id @default(cuid())
  videoId         String
  sourceHash      String   // sha256 of the uploaded file
  originalName    String
  storagePath     String   // relative path under MEDIA_STORAGE_PATH
  fileSize        Int      // bytes
  duration        Float    // seconds
  width           Int
  height          Int
  codec           String
  audioCodec      String
  frameRate       Float
  bitrate         Int      // kbps
  createdAt       DateTime @default(now())

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model VideoRendition {
  id            String   @id @default(cuid())
  videoId       String
  resolution    String   // "1080p", "720p", "480p", "360p"
  height        Int
  width         Int
  bitrate       Int      // kbps
  codec         String   // e.g. "h264"
  manifestPath  String   // relative path to index.m3u8
  createdAt     DateTime @default(now())

  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model VideoManifest {
  id              String   @id @default(cuid())
  videoId         String
  version         String   // "v1", "v2", ...
  hash            String   // sha256 of the manifest contents
  manifestPath    String   // relative path to master.m3u8
  createdAt       DateTime @default(now())

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model MediaProcessingJob {
  id              String   @id @default(cuid())
  videoId         String
  status          String   // UPLOADING | UPLOADED | QUEUED | CLAIMED | PROCESSING | PACKAGING | VALIDATING | READY | FAILED | RETRYABLE_FAILURE | PERMANENT_FAILURE | CANCELLED
  progress        Int      @default(0) // 0-100
  error           String   @default("")
  errorClass      String   @default("") // transient | permanent | ""
  profile         String   @default("cpu-safe") // cpu-safe | balanced | high-quality
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  priority        Int      @default(0) // higher = more urgent
  claimedBy       String?  // worker identity (hostname + pid)
  claimedAt       DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([status])
  @@index([status, priority])
}

model Swarm {
  id              String   @id @default(cuid())
  swarmId         String   @unique // sha256(videoId + renditionId + manifestVersion)
  videoId         String
  renditionId     String
  manifestVersion String
  activePeers     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([videoId])
  @@index([swarmId])
}

model PlaybackSession {
  id              String   @id @default(cuid())
  videoId         String
  renditionId     String
  peerId          String   // temporary, rotated per session
  browserId       String
  networkType     String   @default("unknown")
  swarmId         String?
  p2pEnabled      Boolean  @default(false)
  startedAt       DateTime @default(now())
  endedAt         DateTime?

  @@index([videoId])
  @@index([peerId])
}

model PlaybackTelemetry {
  id              String   @id @default(cuid())
  sessionId       String
  videoId         String
  cdnBytes        Int      @default(0)
  p2pBytes        Int      @default(0)
  rebufferCount   Int      @default(0)
  rebufferDuration Float   @default(0) // seconds
  startupTime     Float    @default(0) // seconds
  peerCount       Int      @default(0)
  p2pFailures     Int      @default(0)
  httpFallbackCount Int    @default(0)
  currentRendition String  @default("")
  timestamp       DateTime @default(now())

  @@index([sessionId])
  @@index([videoId])
}

// ── Transactional Outbox (§20) ──
// Every critical business mutation requiring downstream effects writes
// BUSINESS DATA + OUTBOX EVENT in the same Turso transaction.
// Inngest processes the outbox asynchronously.
model OutboxEvent {
  id              String   @id @default(cuid())
  aggregateType   String   // e.g. "User", "Video", "Comment"
  aggregateId     String   // e.g. the user/video/comment ID
  eventType       String   // e.g. "user.registered", "video.uploaded"
  schemaVersion   Int      @default(1)
  payload         String   // JSON-encoded event payload
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())
  processedAt     DateTime?
  attemptCount    Int      @default(0)
  status          String   @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED | DEAD_LETTER
  lastError       String   @default("")
  idempotencyKey  String?  @unique
  correlationId   String?
  causationId     String?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

// ── Notifications (social-media structuring audit gap) ──
// In-app notifications for the bell icon. Replaces the SAMPLE_NOTIFS hardcoded
// mock. Notifications are created by domain events (new comment on your video,
// new subscriber, new video from a subscribed channel, tip received) and read
// via /api/notifications (cursor-paginated).
model Notification {
  id          String    @id @default(cuid())
  // Recipient: a userId (authenticated) or browserId (anonymous).
  recipientId String
  // Type of notification for icon + routing.
  type        String    // new_video | new_comment | new_subscriber | tip_received | system | mention
  // JSON-encoded payload (title, body, linkUrl, actorAvatarUrl, etc.).
  payload     String
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, read])
}

// ── Notification preferences (per-user bell settings) ──
// Persisted notification preference per user. Replaces the stateless React
// toggles flagged by the audit.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  newVideos    Boolean  @default(true)
  comments     Boolean  @default(true)
  subscribers  Boolean  @default(true)
  tips         Boolean  @default(true)
  mentions     Boolean  @default(true)
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Shares (engagement tracking — audit gap) ──
// Records when a user shares a video (for virality metrics + recommendations).
model Share {
  id          String   @id @default(cuid())
  videoId     String
  // The sharer (userId or anonymous browserId).
  sharerId    String
  // Where the share went (twitter | facebook | copy_link | email | ...).
  platform    String   @default("copy_link")
  createdAt   DateTime @default(now())

  @@index([videoId])
  @@index([sharerId])
}

// ── User Preferences (§69 — user defaults) ──
// Persists user-controlled preferences so the user doesn't reconfigure the
// experience every visit. Quality, speed, Shorts, AI-content, home mode,
// discovery mix, search sort, etc.
model UserPreference {
  id              String   @id @default(cuid())
  // The signed browserId (anonymous) or userId (authenticated).
  ownerId         String   @unique
  // ── Player defaults (§33-36) ──
  preferredQuality String  @default("auto") // auto | 144p | 240p | 360p | 480p | 720p | 1080p | 1440p | 2160p
  preferredSpeed   Float    @default(1) // 0.5 | 0.75 | 1 | 1.25 | 1.5 | 2
  preferredVolume  Int      @default(100) // 0-100
  // ── Subtitle + audio preferences (§35-36) ──
  preferredSubtitleLang String @default("") // ISO 639-1, empty = off
  preferredAudioLang String  @default("") // empty = original
  // ── Content preferences (§16-18) ──
  disableShorts    Boolean  @default(false) // §16: persistent "disable Shorts"
  aiContentFilter  String   @default("show_all") // show_all | prefer_human | reduce_ai | hide_ai
  // ── Home feed preferences (§6) ──
  homeMode         String   @default("smart") // focus | following | chronological | discovery | smart | random
  // Discovery mix percentages (§9) — must sum to ~100.
  discoveryFamiliar Int     @default(60) // % familiar content
  discoveryNewCreators Int  @default(25) // % new creators
  discoveryUnexpected Int   @default(15) // % unexpected subjects
  // ── Search defaults (§12) ──
  searchSort       String   @default("relevance") // relevance | newest | oldest | most_viewed | least_viewed | longest | shortest
  // ── Privacy (§26, §55) ──
  pauseRecommendationLearning Boolean @default(false) // §26: pause rec learning
  // ── Accessibility (§58) ──
  reducedMotion    Boolean  @default(false)
  highContrast     Boolean  @default(false)
  largeControls    Boolean  @default(false)
  // ── Continue Watching (§32) ──
  continueWatchingEnabled Boolean @default(true)
  autoplayNext     Boolean  @default(false)
  // Timestamps.
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── Recommendation Feedback (§10 — negative controls) ──
// Records explicit user feedback on recommendations. Each feedback has a
// real, persistent effect on the recommendation engine.
model RecommendationFeedback {
  id          String   @id @default(cuid())
  userId      String   // signed browserId or userId
  videoId     String
  // The reason the user gave (§10).
  reason      String   // not_interested | already_watched | wrong_topic | too_repetitive | low_quality | clickbait | misleading | wrong_language | wrong_format | ai_generated | dont_like_creator
  // Optional free-text note from the user.
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@unique([userId, videoId]) // one feedback per user+video
  @@index([userId])
  @@index([videoId])
}

// ── User Blocks (§11 — topic/keyword/creator blocking) ──
// Persistent blocks that affect Home, Search, Up Next, Discovery, and
// Notifications (§11). The FYP and search must filter these out.
model UserBlock {
  id          String   @id @default(cuid())
  userId      String   // signed browserId or userId
  // The type of block (§11).
  blockType   String   // topic | keyword | creator | content_type | language | ai_content
  // The value being blocked (e.g. "technology" for topic, "@spammer" for creator).
  blockValue  String
  createdAt   DateTime @default(now())

  @@unique([userId, blockType, blockValue])
  @@index([userId])
  @@index([blockType])
}

// ── Continue Watching (§32 — cross-device playback state) ──
// Persists where the user left off so they can resume on any device.
model ContinueWatching {
  id          String   @id @default(cuid())
  userId      String   // signed browserId or userId
  videoId     String
  // Where the user stopped (seconds into the video).
  position    Float    @default(0)
  // Whether the video was completed.
  completed   Boolean  @default(false)
  // Playback state to restore (§32).
  playbackSpeed Float  @default(1)
  qualityPref String   @default("auto")
  audioLang   String   @default("")
  subtitleLang String  @default("")
  updatedAt   DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
  @@index([updatedAt])
}

// ── Content Provenance (§17 — AI-content labeling) ──
// Records the origin of a video so users can make informed choices (§18).
model ContentProvenance {
  id          String   @id @default(cuid())
  videoId     String   @unique
  // The overall origin (§17).
  origin      String   @default("unknown") // human | ai_assisted | ai_generated | mixed | unknown
  // Component-level origin (§17) — JSON-encoded: { voice, visuals, script, music, translation, dubbing }
  components  String   @default("{}")
  // Creator-declared source/provenance metadata.
  sourceNote  String   @default("")
  // Whether the provenance was creator-declared or platform-detected.
  declared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([origin])
}
