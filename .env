# ── App ──
APP_URL=http://localhost:3000
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Browser ID HMAC secret (stable across server restarts — prevents 403s) ──
# CRITICAL: do not remove this — without it, the server falls back to a random
# per-process secret, which invalidates all browserIds on every dev restart.
BROWSER_ID_SECRET=mashahd-dev-stable-secret-9f3b7e2a8c1d4f6b0e5a2c8d7f1b4e9a

# ── Media storage ──
MEDIA_STORAGE_PATH=/home/z/my-project/storage
STORAGE_PROVIDER=local

# ── FFmpeg ──
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── P2P / WebRTC ──
P2P_ENABLED=true
P2P_MAX_PEERS=6
P2P_MAX_UPLOAD_MBPS=2
P2P_MAX_UPLOAD_BYTES=262144000
P2P_SIGNALING_URL=ws://localhost:3003
P2P_BACKGROUND_ENABLED=false
P2P_LOW_BATTERY_MODE=true
TURN_ENABLED=false

# ── Watch-party (live chat + co-watch) ──
ALLOWED_ORIGINS=http://localhost:3000

# ── Turso (libSQL) production database — uncomment for prod ──
# TURSO_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token-here

# ── Neon Postgres (analytics warehouse) — uncomment for prod ──
# NEON_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── Inngest (durable workflows) — uncomment for prod ──
# INNGEST_KEY=your-inngest-key
# INNGEST_WEBHOOK_SECRET=your-inngest-webhook-secret

# ── Brevo (transactional email) — uncomment for prod ──
# BREVO_API_KEY=your-brevo-api-key
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_WEBHOOK_SECRET=your-brevo-webhook-secret

# ── AI Providers (multi-provider with fallback — uncomment for prod) ──
# GROQ_API_KEY=your-groq-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# NVIDIA_API_KEY=your-nvidia-api-key
# GEMINI_API_KEY=your-gemini-api-key
# HF_API_KEY=your-huggingface-api-key
